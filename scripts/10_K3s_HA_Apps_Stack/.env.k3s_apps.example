# Configuration centralisée - Déploiement applications K3s KeyBuzz
# Généré automatiquement si absent
# NE PAS COMMITER CE FICHIER DANS GIT!

###############################################################################
# TOPOLOGY K3S
###############################################################################
K3S_MASTER_01_IP="10.0.0.100"
K3S_MASTER_02_IP="10.0.0.101"
K3S_MASTER_03_IP="10.0.0.102"

K3S_WORKER_01_IP="10.0.0.110"
K3S_WORKER_02_IP="10.0.0.111"
K3S_WORKER_03_IP="10.0.0.112"
K3S_WORKER_04_IP="10.0.0.113"
K3S_WORKER_05_IP="10.0.0.114"

# Load Balancers
LB_API_01="10.0.0.5"
LB_API_02="10.0.0.6"
LB_HAPROXY="10.0.0.10"

LB_PUBLIC_01="49.13.42.76"
LB_PUBLIC_02="138.199.132.240"

###############################################################################
# INGRESS NGINX (DaemonSet + hostNetwork)
###############################################################################
INGRESS_HTTP_NODEPORT="31695"
INGRESS_HTTPS_NODEPORT="32720"
INGRESS_NAMESPACE="ingress-nginx"

###############################################################################
# DATABASE (via lb-haproxy)
###############################################################################
DB_HOST="10.0.0.10"
DB_PORT_WRITE="5432"
DB_PORT_READ="5433"
DB_PGBOUNCER_PORT="4632"

# PostgreSQL root credentials
POSTGRES_ADMIN_USER="postgres"
POSTGRES_ADMIN_PASSWORD=""

###############################################################################
# REDIS (via lb-haproxy)
###############################################################################
REDIS_HOST="10.0.0.10"
REDIS_PORT="6379"
REDIS_PASSWORD=""

###############################################################################
# RABBITMQ (via lb-haproxy)
###############################################################################
RABBITMQ_HOST="10.0.0.10"
RABBITMQ_PORT="5672"
RABBITMQ_UI_PORT="15672"
RABBITMQ_USER="admin"
RABBITMQ_PASSWORD=""

###############################################################################
# MARIADB GALERA (pour ERPNext)
###############################################################################
MARIADB_HOST="10.0.0.10"
MARIADB_PORT="6033"
MARIADB_ROOT_PASSWORD=""
MARIADB_ERPNEXT_DB="erpnext"
MARIADB_ERPNEXT_USER="erpnext"
MARIADB_ERPNEXT_PASSWORD=""

###############################################################################
# CERT-MANAGER
###############################################################################
CERT_MANAGER_VERSION="v1.13.3"
CERT_MANAGER_EMAIL="admin@keybuzz.io"
HETZNER_DNS_TOKEN=""

###############################################################################
# N8N
###############################################################################
N8N_NAMESPACE="n8n"
N8N_VERSION="latest"
N8N_DOMAIN="n8n.keybuzz.io"
N8N_DB_NAME="n8n"
N8N_DB_USER="n8n"
N8N_DB_PASSWORD=""
N8N_ENCRYPTION_KEY=""
N8N_WEBHOOK_URL="https://n8n.keybuzz.io"

###############################################################################
# LITELLM
###############################################################################
LITELLM_NAMESPACE="litellm"
LITELLM_VERSION="latest"
LITELLM_DOMAIN="llm.keybuzz.io"
LITELLM_DB_NAME="litellm"
LITELLM_DB_USER="litellm"
LITELLM_DB_PASSWORD=""
LITELLM_MASTER_KEY=""

###############################################################################
# QDRANT
###############################################################################
QDRANT_NAMESPACE="qdrant"
QDRANT_VERSION="latest"
QDRANT_DOMAIN="qdrant.keybuzz.io"
QDRANT_API_KEY=""

###############################################################################
# CHATWOOT
###############################################################################
CHATWOOT_NAMESPACE="chatwoot"
CHATWOOT_VERSION="latest"
CHATWOOT_DOMAIN="connect.keybuzz.io"
CHATWOOT_DB_NAME="chatwoot"
CHATWOOT_DB_USER="chatwoot"
CHATWOOT_DB_PASSWORD=""
CHATWOOT_SECRET_KEY_BASE=""
CHATWOOT_INSTALLATION_NAME="KeyBuzz Chatwoot"

###############################################################################
# SUPERSET
###############################################################################
SUPERSET_NAMESPACE="superset"
SUPERSET_VERSION="latest"
SUPERSET_DOMAIN="monitor.keybuzz.io"
SUPERSET_DB_NAME="superset"
SUPERSET_DB_USER="superset"
SUPERSET_DB_PASSWORD=""
SUPERSET_SECRET_KEY=""
SUPERSET_ADMIN_USER="admin"
SUPERSET_ADMIN_PASSWORD=""
SUPERSET_ADMIN_EMAIL="admin@keybuzz.io"

###############################################################################
# ERPNEXT
###############################################################################
ERPNEXT_NAMESPACE="erpnext"
ERPNEXT_VERSION="v15"
ERPNEXT_DOMAIN="erp.keybuzz.io"
ERPNEXT_SITE_NAME="erp.keybuzz.io"
ERPNEXT_ADMIN_PASSWORD=""

###############################################################################
# SSH ACCESS (pour orchestration depuis install-01)
###############################################################################
SSH_USER="root"
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"

###############################################################################
# INSTALLATION OPTIONS
###############################################################################
# Auto-confirm installations (no user prompts)
AUTO_CONFIRM="true"

# Wait times (seconds)
WAIT_INGRESS_READY="60"
WAIT_CERT_MANAGER_READY="30"
WAIT_APP_DEPLOY="30"
WAIT_DB_READY="10"

# Kubeconfig
KUBECONFIG_PATH="/etc/rancher/k3s/k3s.yaml"
