# Configuration MariaDB Galera + ProxySQL + ERPNext
# Généré automatiquement si absent
# NE PAS COMMITER CE FICHIER DANS GIT!

###############################################################################
# TOPOLOGY
###############################################################################
DB01_IP="10.0.0.101"
DB02_IP="10.0.0.102"
DB03_IP="10.0.0.103"
PROXY01_IP="10.0.0.104"
PROXY02_IP="10.0.0.105"
HETZNER_LB_IP="10.0.0.10"
HETZNER_LB_PORT="6033"

###############################################################################
# MARIADB GALERA
###############################################################################
MARIADB_VERSION="10.11"
CLUSTER_NAME="keybuzz_galera_cluster"

# Paths (volumes déjà montés)
MARIADB_DATA_DIR="/opt/keybuzz/mariadb/data"
MARIADB_LOG_DIR="/opt/keybuzz/mariadb/logs"
MARIADB_BACKUP_DIR="/opt/keybuzz/mariadb/backups"

# Credentials (générés automatiquement si vides)
MYSQL_ROOT_PASSWORD=""
SST_USER="sst_user"
SST_PASSWORD=""
PROXYSQL_MONITOR_USER="proxysql-cluster"
PROXYSQL_MONITOR_PASSWORD=""
ERPNEXT_DB_USER="erpnext"
ERPNEXT_DB_PASSWORD=""
ERPNEXT_DB_NAME="erpnext"
MYSQLD_EXPORTER_USER="mysqld_exporter"
MYSQLD_EXPORTER_PASSWORD=""

###############################################################################
# PROXYSQL
###############################################################################
PROXYSQL_VERSION="2.5.5"
PROXYSQL_ADMIN_USER="admin"
PROXYSQL_ADMIN_PASSWORD=""
PROXYSQL_MYSQL_PORT="6033"
PROXYSQL_ADMIN_PORT="6032"

# Hostgroups
WRITER_HOSTGROUP="10"
READER_HOSTGROUP="20"
OFFLINE_HOSTGROUP="30"

###############################################################################
# ERPNEXT
###############################################################################
ERPNEXT_VERSION="v15"
ERPNEXT_NAMESPACE="erpnext"
ERPNEXT_SITE_NAME="erp.keybuzz.local"
ERPNEXT_ADMIN_PASSWORD=""

# Redis URLs (auto-configurés dans le namespace K8s)
REDIS_CACHE_URL="redis://redis-cache:6379"
REDIS_QUEUE_URL="redis://redis-queue:6379"
REDIS_SOCKETIO_URL="redis://redis-socketio:6379"

###############################################################################
# SSH ACCESS (pour orchestration depuis install-01)
###############################################################################
SSH_USER="root"
SSH_KEY_PATH="$HOME/.ssh/id_rsa"

###############################################################################
# INSTALLATION OPTIONS
###############################################################################
# Skip XFS formatting if volumes already formatted and mounted
SKIP_XFS_FORMAT="true"

# Auto-confirm installations (no user prompts)
AUTO_CONFIRM="true"

# Wait times (seconds)
WAIT_AFTER_BOOTSTRAP="30"
WAIT_CLUSTER_SYNC="60"
WAIT_PROXYSQL_START="15"
WAIT_ERPNEXT_JOB="600"
